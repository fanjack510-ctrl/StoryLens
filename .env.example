STORYLENS_APP_ENV=development
STORYLENS_APP_HOST=127.0.0.1
STORYLENS_APP_PORT=8000
STORYLENS_DATABASE_URL=sqlite:///./data/storylens.db

# Default provider
STORYLENS_DEFAULT_MODEL_PROVIDER=none

# Local llama.cpp server
STORYLENS_LOCAL_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
STORYLENS_LOCAL_LLAMA_API_KEY=local
STORYLENS_LOCAL_LLAMA_MODEL=qwen-local
STORYLENS_LOCAL_LLAMA_TIMEOUT_SECONDS=300
STORYLENS_LOCAL_LLAMA_MAX_CONTEXT_TOKENS=16384
STORYLENS_LLAMA_SERVER_PATH=
STORYLENS_LOCAL_MODEL_PATH=
STORYLENS_LOCAL_LLAMA_PORT=8080
STORYLENS_LOCAL_LLAMA_HOST=127.0.0.1
STORYLENS_LOCAL_LLAMA_PROFILE=safe
STORYLENS_LOCAL_LLAMA_CONTEXT_SIZE=4096
STORYLENS_LOCAL_LLAMA_GPU_LAYERS=16
STORYLENS_LOCAL_LLAMA_PARALLEL=1
STORYLENS_LOCAL_LLAMA_BATCH_SIZE=128
STORYLENS_LOCAL_LLAMA_UBATCH_SIZE=64
STORYLENS_LOCAL_LLAMA_MAX_OUTPUT_TOKENS=128
STORYLENS_LOCAL_LLAMA_COOLDOWN_SECONDS=90
STORYLENS_LOCAL_LLAMA_MONITOR_INTERVAL_SECONDS=2
STORYLENS_LOCAL_LLAMA_MAX_GPU_TEMP_C=80
STORYLENS_LOCAL_LLAMA_MAX_VRAM_MB=14336
STORYLENS_LOCAL_LLAMA_MAX_SINGLE_REQUEST_SECONDS=300

# Scene pipeline
STORYLENS_SCENE_WINDOW_MAX_CHARS=12000
STORYLENS_SCENE_WINDOW_OVERLAP_PARAGRAPHS=4
STORYLENS_SCENE_BOUNDARY_MIN_CONFIDENCE=0.65
STORYLENS_SCENE_BOUNDARY_MIN_VOTE_RATIO=0.5
STORYLENS_MODEL_MAX_ATTEMPTS=3
STORYLENS_PROMPT_ROOT=packages/prompts

# Alibaba Cloud Model Studio (Bailian), cn-beijing. Secrets stay in local .env only.
STORYLENS_ALIYUN_ENABLED=false
STORYLENS_ALIYUN_API_KEY=
STORYLENS_ALIYUN_WORKSPACE_ID=
STORYLENS_ALIYUN_BASE_URL=
STORYLENS_ALIYUN_PLUS_MODEL=qwen3.7-plus
STORYLENS_ALIYUN_MAX_MODEL=qwen3.7-max
STORYLENS_ALIYUN_FLASH_MODEL=qwen3.6-flash
STORYLENS_ALIYUN_TIMEOUT_SECONDS=300
STORYLENS_ALIYUN_MAX_RETRIES=3
STORYLENS_ALIYUN_STRUCTURED_OUTPUT_MODE=json_object
STORYLENS_ALIYUN_ENABLE_THINKING=false
STORYLENS_CLOUD_RAW_LOGGING=false
