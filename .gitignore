backend.err.log
*.out.log
*.err.log

# Frontend / build
node_modules/
dist/
build/
coverage/
.target/
target/

# Windows release artifacts (never commit installers / sidecars)
dist/release/
apps/desktop/src-tauri/binaries/*.exe
apps/api/dist-sidecar/
apps/api/build/
apps/api/build/**

# Updater signing private keys (public key may live in tauri.conf.json)
.tauri/
*.key
!*.key.pub

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# StoryLens open source cleanup
# Runtime artifacts
artifacts/

# Local database
apps/api/data/

# User generated data
uploads/
user-data/

# Local reference-corpus scans and loose working documents
# The scanner output may contain local source paths and must never ship.
data/reference-corpus/
/*.docx

# Local VIP license files (never commit; live under %LOCALAPPDATA%/StoryLens/license/)
*.license
**/license/storylens.license

# Test cache
test-results/

# TypeScript build cache
*.tsbuildinfo

# License issuer secrets (never commit)
private_release/
secrets/
license_private_keys/
*_ed25519_private*
*.ed25519.priv

# Local forensics (never commit)
**/runtime/forensics/

# STEP 2.5 Live temp artifacts (do not commit)
release/evidence/CHG-20260725-003/night-run/*.db
release/evidence/CHG-20260725-003/night-run/_tmp_license_public_keys.live.json

# Local RC smoke scratch (never commit)
release/evidence/**/_smoke/
release/evidence/**/_smoke2/
release/evidence/**/_nsis-extract/
release/evidence/**/_work/


release/evidence/**/_smoke-install/

# 运行期产物。它们每次 git status 都在，总有一天会被 add -A 卷进去。
data/database/
data/logs/
.pytest_out.txt
apps/desktop/.env.local

# 排障时留下的会话/取证日志。一次性的东西，不进版本库。
chg*.jsonl
*-architecture-review*.jsonl
*-architecture-*.txt
long-novel-target-architecture-draft.jsonl

# Claude Code：launch.json 是共享的开发服务器配置，本地设置不进版本库。
.claude/settings.local.json
