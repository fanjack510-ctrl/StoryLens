# Public, non-secret values
STORYLENS_DOMAIN=app.example.com
POCKETBASE_VERSION=0.40.1
# Paths only. The files themselves stay on the server and never enter Git or images.
POCKETBASE_SUPERUSER_EMAIL_FILE=/opt/storylens/shared/secrets/pocketbase-superuser-email
POCKETBASE_SUPERUSER_PASSWORD_FILE=/opt/storylens/shared/secrets/pocketbase-superuser-password
UPLOAD_MAX_BYTES=10485760
WORKER_POLL_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=15
REDIS_CONNECT_TIMEOUT_SECONDS=5
WORKER_REDIS_RETRY_INITIAL_SECONDS=1
WORKER_REDIS_RETRY_MAX_SECONDS=15
AFDIAN_ALLOWED_PLAN_IDS=replace-after-recharge-product-is-created

# Generate strong random values on the server. Never commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
AFDIAN_USER_ID=
AFDIAN_API_TOKEN=
