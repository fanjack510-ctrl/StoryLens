{$STORYLENS_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle /health/* {
        reverse_proxy online-api:8080
    }

    handle /api/* {
        reverse_proxy online-api:8080
    }

    handle {
        respond "StoryLens Online frontend is not deployed in foundation stage" 503
    }
}
