FROM node:22-alpine AS build

WORKDIR /app
COPY apps/online_web/package.json apps/online_web/package-lock.json ./
RUN npm ci
COPY apps/online_web ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY infra/online/nginx-online.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
