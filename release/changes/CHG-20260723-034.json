  "user_summary": "Mock Lab run recovery, idempotency, concurrency, audit, quota/budget, and fault injection for Phase 2A reliability.",
  "technical_summary": "Implemented MockRunIdempotencyService, MockRunConcurrencyGuard, MockRunRecoveryService, CheckpointValidator, MockRunAuditSink, MockExecutionQuotaService/BudgetGuard, FaultInjectionController, and StartupRecoveryAdapter. No new tables, no formal frontend, no real Engine.",
  "acceptance_criteria": [
    "Create/operation idempotency with payload conflict detection",
    "Book active-run concurrency + single executor lease",
    "Startup marks interrupted only; no silent resume",
    "Checkpoint schema/version/engine/snapshot validation",
    "Audit events without body/credential/prompt leakage",
    "Synthetic quota/budget deny prevents asset writes",
    "Fault injection test/dev only and deterministic"
  ],
